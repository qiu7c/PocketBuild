# Local build outputs and secrets
/build/
/Vendor/*.xcframework
/Vendor/REipa/target/
/.local/
*.ipa
*.mobileprovision
*.p12
*.pfx
*.key
*.pem
.env
.env.*
.DS_Store
__pycache__/
*.pyc
# Local icon drafts; the selected master and app icon catalog are versioned.
/Resources/PocketBuild/PocketBuild-icon-v*.png
/Resources/PocketBuild/PocketBuild-3d-*.png
# FLEX/Theos local build state (source and bundled release files are retained)
/Plugins/FLEX/.theos/
/Plugins/FLEX/packages/
/Plugins/FLEX/*.deb
/Plugins/FLEX/*.dylib

# Optional tools are downloaded separately; never commit local resource archives.
/Resources/iSH/developer-tools.tar
/Resources/iSH/reverse-tools.tar
